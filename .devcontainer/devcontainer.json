{
  "name": "homeworlds",
  "image": "mcr.microsoft.com/devcontainers/base",
  "features": {
    "ghcr.io/devcontainer-community/devcontainer-features/opencode.ai:1": {},
    "ghcr.io/devcontainers/features/node:1": {},
  },
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": []
    },
    "codium": {
      "settings": {},
	  "extensions": [],
	},
  },
  "initializeCommand": "mkdir -p \"${localEnv:HOME}/.config/opencode\" \"${localEnv:HOME}/.agents/skills\" && touch \"${localEnv:HOME}/.gitconfig\"",
  "mounts": [
    {
      "source": "${localEnv:HOME}/.config/opencode",
	  "target": "/home/vscode/.config/opencode",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.agents/skills",
	  "target": "/home/vscode/.agents/skills",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.gitconfig",
	  "target": "/home/vscode/.gitconfig",
      "type": "bind"
    },
  ]
}
