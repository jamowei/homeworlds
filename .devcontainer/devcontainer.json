{
  "name": "homeworlds",
  "image": "mcr.microsoft.com/devcontainers/javascript-node",
  "features": {
    "ghcr.io/devcontainer-community/devcontainer-features/opencode.ai:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": []
    },
    "codium": {
      "settings": {},
	  "extensions": [],
	},
  },
  "remoteUser": "${localEnv:USER}",
  "updateRemoteUserUID": true,
  "initializeCommand": "mkdir -p \"${localEnv:HOME}/.config/opencode\" \"${localEnv:HOME}/.agents/skills\" && touch \"${localEnv:HOME}/.gitconfig\"",
  "mounts": [
    {
      "source": "${localEnv:HOME}/.config/opencode",
	  "target": "${localEnv:HOME}/.config/opencode",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.agents/skills",
	  "target": "${localEnv:HOME}/.agents/skills",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.gitconfig",
	  "target": "${localEnv:HOME}/.gitconfig",
      "type": "bind"
    },
  ]
}
